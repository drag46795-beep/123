-- Вернуть коллизии тела (вызывается при выключении)
local function restoreCollisions()
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

-- ==================== РАБОТА С НОЖОМ ====================
local function isKnifeName(tool)
    local n = tool.Name
    local hay = string.lower(n) .. " " .. n
    for _, word in ipairs({ "нож", "Нож", "knife", "blade", "machete", "sword", "kat" }) do
        if hay:find(word, 1, true) then
            return true
        end
    end
    return false
end

local function getKnifeTool()
    local char = LocalPlayer.Character
    local held = char and char:FindFirstChildOfClass("Tool")

    -- нож уже в руках — не трогаем
    if held and isKnifeName(held) then
        return held
    end

    -- ищем нож в рюкзаке (если не нашли по имени — берём 1-й слот)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local named, first
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                first = first or tool -- это и есть "1 слот"
                if isKnifeName(tool) then
                    named = tool
                    break
                end
            end
        end
    end
    return named or first or held
end

local function equipKnife()
    local tool = getKnifeTool()
    if tool and tool.Parent ~= LocalPlayer.Character then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum:EquipTool(tool)
        end
    end
    return tool
end

-- Удар по цели: встать за спиной цели + взмах ножом
local function strike(targetChar)
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not (myRoot and tRoot) then
        return
    end

    local knife = equipKnife()
    if not knife then
        return
    end

    if AF.TPToTarget then
        -- встаём прямо за спиной цели — удар засчитывается даже сквозь стену
        local behind = tRoot.CFrame * CFrame.new(0, 0, 2.5)
        myRoot.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
    else
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, tRoot.Position)
    end

    knife:Activate() -- взмах ножом
end

-- Главный цикл: рубим всех врагов
task.spawn(function()
    while true do
        task.wait(math.max(0.05, AF.Interval))
        if AF.Enabled and AF.KillAll then
            pcall(function()
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                if not myRoot then
                    return
                end

                local inRange, nearest, nearDist = {}, nil, math.huge

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local tc = plr.Character
                        local hum = tc and tc:FindFirstChildOfClass("Humanoid")
                        local root = tc and tc:FindFirstChild("HumanoidRootPart")
                        if hum and root and hum.Health > 0 then
                            local dist = (root.Position - myRoot.Position).Magnitude
                            if dist < nearDist then
                                nearest, nearDist = root, dist
                            end
                            if dist <= AF.Range then
                                table.insert(inRange, root)
                            end
                        end
                    end
                end

                if #inRange > 0 then
                    -- режем всех, кто рядом
                    for _, root in ipairs(inRange) do
                        strike(root.Parent)
                    end
                elseif AF.TPToTarget and nearest then
                    -- никого рядом — телепортируемся к ближайшему врагу
                    strike(nearest.Parent)
                end
            end)
        end
    end
end)

