local RB = {
    Enabled    = false, -- мастер RageBot
    ChargeTime = 1,     -- сколько держать ЛКМ перед броском (сек)
    AimLead    = 0.4,   -- за сколько секунд до броска начинать наводку на голову
    ShootWall  = true,  -- стрелять через стены
    AimWall    = true,  -- наводить (выбирать цель) через стены
    Predict    = true,  -- предиктить движение цели
    KnifeSpeed = 120,   -- скорость полёта ножа для предикта (стад/сек)
    FOV        = 350,   -- радиус FOV в пикселях (0 = без лимита)
    ShowFOV    = true,  -- рисовать круг FOV
}

local holding = false -- ЛКМ зажата
local holdStart = 0   -- когда зажали

-- ---------- мышь (ЛКМ) ----------
local function lmbPress()
