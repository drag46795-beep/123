        lmbRelease()
        holding = false
    end
end

-- ---------- видимость цели (есть ли стена между мной и целью) ----------
local function isVisible(fromPos, targetRoot, targetChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }

    local hit = workspace:Raycast(fromPos, targetRoot.Position - fromPos, params)
    if not hit then
        return true
    end
    if hit.Instance:IsDescendantOf(targetChar) then
        return true
    end
    return (hit.Position - targetRoot.Position).Magnitude < 3
end

local function isTeammate(plr)
    if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
        if plr.Neutral == false and LocalPlayer.Neutral == false then
            return true
        end
    end
    return false
end

-- ---------- проверка на god mode: в таких целях бессмысленно целяться ----------
local function isGodMode(targetChar, hum)
    -- спавн-щит (ForceField) = неуязвимость
    if targetChar:FindFirstChildOfClass("ForceField") then
        return true
    end
    -- бесконечное здоровье — классический god mode
    if hum.Health == math.huge or hum.MaxHealth == math.huge then
        return true
    end
    -- распространённые атрибуты неуязвимости
    for _, attr in ipairs({ "GodMode", "God", "godmode", "Invincible", "Immortal" }) do
        if targetChar:GetAttribute(attr) == true or hum:GetAttribute(attr) == true then
            return true
        end
    end
    return false
end

-- ---------- выбор цели: живой враг в пределах FOV ----------
local function pickTarget()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    if not (myRoot and cam) then
        return nil, nil
    end

    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local bestRoot, bestChar, bestDist = nil, nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isTeammate(plr) then
            local tc = plr.Character
            local hum = tc and tc:FindFirstChildOfClass("Humanoid")
            local root = tc and tc:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 and not isGodMode(tc, hum) then
                local allowed = true
                if not RB.AimWall then
                    allowed = isVisible(myRoot.Position, root, tc)
                end
                if allowed then
                    local sp = cam:WorldToViewportPoint(root.Position)
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if (RB.FOV <= 0 or d <= RB.FOV) and d < bestDist then
                        bestRoot, bestChar, bestDist = root, tc, d
                    end
                end
            end
        end
    end
    return bestRoot, bestChar
end

-- ---------- куда целиться: ровно в голову цели ----------
local function getAimBasePos(targetRoot, targetChar)
    local head = targetChar and targetChar:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.Position
    end
    return targetRoot.Position + Vector3.new(0, 1.5, 0) -- запасной вариант (головы нет)
end

-- ---------- предикт: куда кинуть, чтобы попасть в голову ----------
local function computeAimPos(myRoot, targetRoot, targetChar)
    local pos = getAimBasePos(targetRoot, targetChar)
    if RB.Predict then
        local vel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity
        local dist = (pos - myRoot.Position).Magnitude
        local t = dist / math.max(1, RB.KnifeSpeed)
        pos = pos + vel * t
        -- если нож летит по дуге — раскомментируй (прицел будет выше):
        -- pos = pos + Vector3.new(0, 0.5 * workspace.Gravity * t * t, 0)
    end
    return pos
end

-- ---------- тихая наводка: направление меняется только внутри кадра ----------
local function applySilentAim(aimPos)
    local cam = workspace.CurrentCamera
    if not cam then
        return false
    end
    local oldCF = cam.CFrame
    if (aimPos - oldCF.Position).Magnitude < 1 then
        return false
    end
    local newCF = CFrame.lookAt(oldCF.Position, aimPos)
    cam.CFrame = newCF
    -- возвращаем камеру до рендера: глаза игрока поворот не видит,
    -- но игра уже читает направление на цель
    task.spawn(function()
        RunService.RenderStepped:Wait()
        pcall(function()
            if cam.CFrame == newCF then
                cam.CFrame = oldCF
            end
        end)
    end)
    return true
end

-- молча держим прицел на голове (пока нож заряжается / ждёт момента)
local function silentAim(aimPos)
    applySilentAim(aimPos)
end

-- тихий бросок: ставим прицел и отпускаем ЛКМ в тот же момент
local function silentThrow(aimPos)
    applySilentAim(aimPos)
    lmbRelease()
end

-- ---------- один тик логики RageBot ----------
local function ragebotTick()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        releaseLMB()
        return
    end

    -- ножа в руках нет — пытаемся взять (1 слот)
    local knife = char:FindFirstChildOfClass("Tool")
    if not (knife and isKnifeName(knife)) then
        if os.clock() - lastEquip > 0.4 then
            equipKnife()
            lastEquip = os.clock()
        end
        releaseLMB()
        return
    end

    local targetRoot, targetChar = pickTarget()

    -- нож в руках — зажимаем ЛКМ и заряжаем
    if not holding then
        lmbPress()
        holding = true
        holdStart = os.clock()
        return
    end

    local elapsed = os.clock() - holdStart
    local aimStartAt = math.max(0, RB.ChargeTime - RB.AimLead)

    -- цели нет — сидим заряженным и ждём
    if not targetRoot then
        return
    end

    -- заряд готов и можно стрелять — бросаем
    local canThrow = elapsed >= RB.ChargeTime
        and (RB.ShootWall or isVisible(myRoot.Position, targetRoot, targetChar))

    if canThrow then
        -- последнее уточнение прицела + тихий бросок ровно в голову
        silentThrow(computeAimPos(myRoot, targetRoot, targetChar))
        holding = false -- отпустили; на следующем тике зажмём снова
    elseif elapsed >= aimStartAt then
        -- за AimLead секунд до броска — тихо ведём прицел на голове цели,
        -- обновляя его каждый тик, пока нож не кинется
        silentAim(computeAimPos(myRoot, targetRoot, targetChar))
    end
end

-- ---------- главный цикл RageBot ----------
task.spawn(function()
    while true do
        task.wait(0.03)
        if not RB.Enabled then
            releaseLMB()
        else
            local ok, err = pcall(ragebotTick)
            if not ok then
                warn("[RageBot] " .. tostring(err))
            end
        end
    end
end)

-- ---------- круг FOV ----------
local fovCircle = nil

local function ensureFOVCircle()
    if fovCircle then
        return true
    end
    local ok = pcall(function()
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 2
        fovCircle.NumSegments = 64
        fovCircle.Filled = false
        fovCircle.Color = Color3.fromRGB(255, 70, 70)
        fovCircle.Transparency = 1
        fovCircle.Visible = false
    end)
    return ok and fovCircle ~= nil
end

RunService.RenderStepped:Connect(function()
    local show = RB.Enabled and RB.ShowFOV and RB.FOV > 0
    if not show then
        if fovCircle then
            fovCircle.Visible = false
        end
        return
    end
    if not ensureFOVCircle() then
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then
        return
    end
    local vp = cam.ViewportSize
    fovCircle.Visible = true
    fovCircle.Radius = RB.FOV
    fovCircle.Position = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end)

