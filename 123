-- Функция переключения звёздного неба
local function setStarrySky(enable)
    local existingSky = Lighting:FindFirstChild("CustomStarrySky")
    
    if enable then
        local oldSky = Lighting:FindFirstChildOfClass("Sky")
        if oldSky and oldSky.Name ~= "CustomStarrySky" then
            oldSky:Destroy()
        end

        if not existingSky then
            local sky = Instance.new("Sky")
            sky.Name = "CustomStarrySky"
            for prop, val in pairs(starryTextures) do
                sky[prop] = val
            end
            sky.Parent = Lighting
        end

        Lighting.ClockTime = 0
        Lighting.Brightness = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(60, 60, 90)
    else
        if existingSky then
            existingSky:Destroy()
        end
        Lighting.ClockTime = 14
        Lighting.Brightness = 2
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end
end

